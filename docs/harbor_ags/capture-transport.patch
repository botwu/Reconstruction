+    def test_sse_is_forwarded_before_upstream_finishes_or_buffer_fills(self) -> None:
+        connection = http.client.HTTPConnection("127.0.0.1", self.proxy.port, timeout=1)
+        connection.request(
+            "POST", "/v1/messages",
+            body=json.dumps({"stream": True, "pause_after_first": True}),
+            headers={"Content-Type": "application/json"},
+        )
+        response = connection.getresponse()
+        try:
+            self.assertTrue(self.upstream.frame_sent.wait(timeout=1))
+            self.assertEqual(response.readline(), b"event: message_start\n")
+        finally:
+            self.upstream.continue_stream.set()
+        self.assertIn(b"event: message_stop", response.read())
+        connection.close()
+
+    def test_idle_stream_timeout_records_empty_failed_attempt(self) -> None:
