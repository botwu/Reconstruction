+    def test_recovered_attempt_still_validates_all_evidence(self) -> None:
+        failed, successful = _transport_retry_pair()
+        cases = [
+            ({"request": {**failed["request"], "sha256": "forged"}}, "CAPTURE_BODY_HASH_MISMATCH"),
+            ({"response": {
+                **failed["response"],
+                "body": {**failed["response"]["body"], "size_bytes": 1},
+            }}, "CAPTURE_BODY_SIZE_MISMATCH"),
+            ({"duration_ms": -1}, "CAPTURE_DURATION"),
+            ({"response_headers": {"Authorization": "secret"}}, "CAPTURE_AUTH_HEADER_PERSISTED"),
+            ({"response_headers": []}, "CAPTURE_HEADERS_SHAPE"),
+            ({"method": "GET"}, "CAPTURE_EXCHANGE_FIELD"),
+        ]
+        for changes, expected in cases:
+            with self.subTest(expected=expected):
+                attempt = {**failed, **changes}
+                codes = {
+                    item["code"] for item in _validate_capture_records([attempt, successful], [])
+                }
+                self.assertIn(expected, codes)
+
+        # Sharing a claimed digest never makes different raw requests equivalent.
+        forged = _captured_body({"messages": [{"role": "user", "content": "different"}]})
+        forged["sha256"] = successful["request"]["sha256"]
+        attempt = {**failed, "request": forged}
+        codes = {item["code"] for item in _validate_capture_records([attempt, successful], [])}
+        self.assertIn("CAPTURE_BODY_HASH_MISMATCH", codes)
+        self.assertIn("MODEL_EXCHANGE_INCOMPLETE", codes)
