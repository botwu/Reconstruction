+        status, body, _ = self._request({"stream": True, "stall_before_first": True})
+        self.upstream.continue_stream.set()
+        self.assertEqual(status, 200)
+        self.assertEqual(body, b"")
+        exchange = json.loads((self.root / "anthropic-exchanges.jsonl").read_text())
+        self.assertFalse(exchange["complete"])
+        self.assertEqual(exchange["error_code"], "UPSTREAM_TRANSPORT_ERROR")
+        self.assertEqual(exchange["sse_event_count"], 0)
+        self.assertEqual(exchange["response"]["body"]["size_bytes"], 0)
